#!/bin/bash
set -euo pipefail

# retry <number-of-retries> <command>
function retry {
	local retries=$1
	shift
	local attempts=1
	local status=0

	until "$@"; do
		status=$?
		echo "Exited with $status"
		if ((retries == "0")); then
			return $status
		elif ((attempts == retries)); then
			echo "Failed $attempts retries"
			return $status
		else
			echo "Retrying $((retries - attempts)) more times..."
			attempts=$((attempts + 1))
			sleep $(((attempts - 2) * 2))
		fi
	done
}

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

debug_mode="false"
if [[ ${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_DEBUG_MODE:-false} =~ (true|on|1) ]]; then
	echo "--- :hammer: Enabling debug mode"
	debug_mode="true"
fi

workdir="/workdir"

# Pinned: uv is installed inside the container on every run
uv_version="0.13.1"

default_image="python:3.15-slim"
image="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_CUSTOM_IMAGE:-$default_image}"

if [ -z "${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_GCP_PROJECT:-}" ]; then
	echo "ERROR: gcp project (gcp_project) key not set"
	exit 1
fi

gcp_project="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_GCP_PROJECT}"

if [ -z "${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_GCP_REGION:-}" ]; then
	echo "ERROR: gcp region (gcp_region) not set"
	exit 1
fi

gcp_region="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_GCP_REGION}"

if [ -z "${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_CLOUD_FUNCTION_NAME:-}" ]; then
	echo "ERROR: cloud function name (cloud_function_name) not set"
	exit 1
fi

cloud_function_name="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_CLOUD_FUNCTION_NAME}"

if [ -z "${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_CLOUD_FUNCTION_DIRECTORY:-}" ]; then
	echo "ERROR: cloud function directory (cloud_function_directory) not set"
	exit 1
fi

cloud_function_directory="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_CLOUD_FUNCTION_DIRECTORY}"

# plugin.yml booleans arrive as strings: normalise to true/false
wait="true"
if [[ ! ${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_WAIT:-true} =~ ^(true|on|yes|1)$ ]]; then
	wait="false"
fi

wait_timeout="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_WAIT_TIMEOUT:-600}"
if [[ ! ${wait_timeout} =~ ^[0-9]+$ ]]; then
	echo "ERROR: wait_timeout must be a number of seconds, not '${wait_timeout}'"
	exit 1
fi

# Credentials: a service account key (the `gcp_service_account` plugin option or,
# as before, a `gcp_service_account` environment variable), or else Application
# Default Credentials (the metadata server of the agent's cloud identity, Workload
# Identity, or the file named by GOOGLE_APPLICATION_CREDENTIALS, which is mounted
# read-only).
gcp_service_account="${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_GCP_SERVICE_ACCOUNT:-${gcp_service_account:-}}"

adc_credentials_file=""
if [ -n "${gcp_service_account}" ]; then
	echo "--- :key: Authenticating with the gcp_service_account key"
else
	echo "--- :key: gcp_service_account is not set, using Application Default Credentials"
	if [[ -n ${GOOGLE_APPLICATION_CREDENTIALS:-} ]]; then
		if [[ ! -f ${GOOGLE_APPLICATION_CREDENTIALS} ]]; then
			echo "ERROR: GOOGLE_APPLICATION_CREDENTIALS points to a file that does not exist: ${GOOGLE_APPLICATION_CREDENTIALS}"
			exit 1
		fi
		adc_credentials_file="${GOOGLE_APPLICATION_CREDENTIALS}"
	fi
fi

if [[ ${debug_mode} == "true" ]]; then
	echo "Configuration:"
	echo "GCP Project: ${gcp_project}"
	echo "GCP Region: ${gcp_region}"
	echo "Cloud Function Name: ${cloud_function_name}"
	echo "Cloud Function Directory: ${cloud_function_directory}"
	echo "Wait for deployment: ${wait} (timeout ${wait_timeout}s)"
	echo "Docker Image: ${image}"
fi

# Only an allowlist of variables reaches the container. The container runs code
# installed from PyPI, so it must not see the rest of the job environment (other
# secrets, the agent access token). `--env NAME` without a value copies the
# value from this process's environment, which keeps secrets off the command line.
args=("--init" "--workdir" "${workdir}")

for proxy_var in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
	if [[ -n ${!proxy_var:-} ]]; then
		args+=(--env "${proxy_var}")
	fi
done

args+=(
	"--env" "gcp_project=$gcp_project"
	"--env" "gcp_region=$gcp_region"
	"--env" "cloud_function_name=$cloud_function_name"
	"--env" "cloud_function_directory=$cloud_function_directory"
	"--env" "debug_mode=$debug_mode"
	"--env" "wait=$wait"
	"--env" "wait_timeout=$wait_timeout"
)

if [[ -n ${gcp_service_account} ]]; then
	args+=("--env" "credentials")
elif [[ -n $adc_credentials_file ]]; then
	args+=(
		"--volume" "${adc_credentials_file}:/run/secrets/google-adc.json:ro"
		"--env" "GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json"
	)
fi

# Add the image in before the shell and command
args+=("${image}")

# Assemble the shell and command arguments into the docker arguments
command=()
display_command=()

shell=("/bin/sh" "-e" "-c")
args+=("${shell[@]}")
display_command+=("${shell[@]}")

command+=("pip install --quiet uv==${uv_version} && uv pip install --system -q --require-hashes -r plugin_scripts/requirements.lock && python -m plugin_scripts.__init__")

# join command lines
command_string="$(
	IFS=$'\n'
	echo "${command[*]}"
)"

args+=("${command_string}")
display_command+=("'${command_string}'")

echo "--- :docker: Pulling ${image}"
rv=0
retry "${BUILDKITE_PLUGIN_CLOUD_FUNCTIONS_DOCKER_PULL_RETRIES:-3}" docker pull "${image}" || rv=$?
if ((rv != 0)); then
	echo "--- :docker: Pull failed."
	exit "$rv"
fi

echo '--- :docker: Logging "docker create" command'
echo "$ docker create" >&2

echo "--- :docker: Running command in ${image}"
echo "$ ${display_command[*]}" >&2

if [[ ${debug_mode} == "true" ]]; then
	echo "docker create" >&2
	echo "docker cp \"${PWD}/.\" \"dockerContainerID:${workdir}\"" >&2
fi

# For copy-checkout, we have to `docker create`, then `docker cp "${PWD}:${workdir}"`, then `docker start`
# The key is handed to docker by variable name only, so it is never on a command line.
DOCKERID=$(credentials="${gcp_service_account}" docker create "${args[@]}")

# The container is removed on every exit path, including a failed `docker cp`
function cleanup {
	docker rm -f "${DOCKERID}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker cp "${PWD}/." "${DOCKERID}:${workdir}"
docker cp "${PLUGIN_DIR}/plugin_scripts" "${DOCKERID}:${workdir}/plugin_scripts"
docker start -a "${DOCKERID}"
